#!/usr/bin/env bash
# Runs tests/e2e/*.py against the host's Zen (or $BROWSER_BIN) headless, inside a container.
# Fresh throwaway profile every run: never touches the user's Zen profile.
set -euo pipefail
cd "$(dirname "$0")/.."
# geckodriver wants the ELF, not the Nix bash wrapper: bin/zen-beta -> bin/.zen-beta-wrapped -> lib/zen-bin-*/zen.
W="$(readlink -f "$HOME/.nix-profile/bin/zen-beta")"
BIN="${BROWSER_BIN:-$(readlink -f "$(dirname "$W")/.zen-beta-wrapped")}"
# Bypassing the wrapper also drops its LD_LIBRARY_PATH (libpulseaudio, libcanberra…): replay those entries.
LIBS="$(grep -a -o "^LD_LIBRARY_PATH='[^']*'" "$W" | cut -d"'" -f2 | paste -sd: -)"
docker build -q -t burbuja-e2e tests/e2e >/dev/null
# open shadow root so Selenium can look inside; never ship this build
WXT_E2E=1 ./scripts/npm run build:firefox >/dev/null
mkdir -p .output/e2e
BLOCK=()
# E2E_BLOCK_GOOGLE=1: Google hosts resolve to loopback → real connection failures → fallback path
[ "${E2E_BLOCK_GOOGLE:-0}" = 1 ] && BLOCK=(--add-host translate-pa.googleapis.com:127.0.0.1 --add-host translate.googleapis.com:127.0.0.1 -e E2E_BLOCK_GOOGLE=1)
exec docker run --rm "${BLOCK[@]}" -v /nix:/nix:ro -v "${PWD}:/app" -w /app --user 0:0 --memory 4g --cpus 4 --shm-size 1g \
  -e BROWSER_BIN="$BIN" -e MOZ_HEADLESS=1 -e HOME=/tmp -e LD_LIBRARY_PATH="$LIBS" \
  burbuja-e2e python -u -m tests.e2e.run "$@"
