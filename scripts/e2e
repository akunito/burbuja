#!/usr/bin/env bash
# Runs tests/e2e/*.py against the host's Zen (or $BROWSER_BIN) headless, inside a container.
# Fresh throwaway profile every run: never touches the user's Zen profile.
set -euo pipefail
cd "$(dirname "$0")/.."
# geckodriver wants the ELF, not the Nix bash wrapper: bin/zen-beta -> bin/.zen-beta-wrapped -> lib/zen-bin-*/zen.
W="$(readlink -f "$HOME/.nix-profile/bin/zen-beta")"
BIN="${BROWSER_BIN:-$(readlink -f "$(dirname "$W")/.zen-beta-wrapped")}"
docker build -q -t burbuja-e2e tests/e2e >/dev/null
mkdir -p .output/e2e
exec docker run --rm -v /nix:/nix:ro -v "${PWD}:/app" -w /app --user 0:0 --memory 4g --cpus 4 --shm-size 1g \
  -e BROWSER_BIN="$BIN" -e MOZ_HEADLESS=1 -e HOME=/tmp \
  burbuja-e2e python -u -m tests.e2e.run "$@"
