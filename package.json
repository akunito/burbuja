{
  "name": "burbuja",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "description": "Selection translation bubble for Firefox and Zen: Google with automatic Bing/DeepL fallback, dark by default.",
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox && wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b firefox",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "lint:ext": "web-ext lint --source-dir .output/firefox-mv2 --self-hosted",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  }
}
